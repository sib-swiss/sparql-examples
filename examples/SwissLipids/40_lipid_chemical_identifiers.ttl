@prefix ex: <https://sparql.swisslipids.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:40_lipid_chemical_identifiers a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Given a SwissLipids entry, retrieve its basic chemical identifiers: molecular formula, net charge, InChI, InChIKey and SMILES."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX SWISSLIPID: <https://swisslipids.org/rdf/SLM_>
PREFIX chemrof: <https://w3id.org/chemrof/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?lipid ?label ?formula ?charge ?inchi ?inchikey ?smiles
WHERE {
  VALUES ?lipid { SWISSLIPID:000000035 }
  ?lipid rdfs:label ?label ;
    chemrof:generalized_empirical_formula ?formula ;
    chemrof:charge ?charge ;
    chemrof:inchi_string ?inchi ;
    chemrof:inchi_key_string ?inchikey ;
    chemrof:smiles_string ?smiles .
}""" ;
    schema:target <https://sparql.swisslipids.org/sparql/> .

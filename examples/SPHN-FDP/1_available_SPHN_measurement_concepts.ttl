@prefix ex: <https://purl.expasy.org/sparql-examples/SPHN-FDP/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:1_available_SPHN_measurement_concepts a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "Which types of measurements are available in the SPHN Federated Clinical Routine Dataset (FedData)?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-metacat: <https://biomedit.ch/rdf/sphn-metacat/sphn/>
PREFIX void: <http://rdfs.org/ns/void#>

SELECT DISTINCT ?class
WHERE {
  <http://fdp.dcc.sib.swiss/dataset/58cd4839-5821-5dee-a859-72e4462c3659> dcat:distribution ?distribution .
  ?distribution sphn-metacat:hasConceptAvailability ?concept_availability .
  ?concept_availability void:classPartition/void:class ?class .
  ?class rdfs:subClassOf sphn:Measurement .
}""" ;
 schema:target <https://fdp.dcc.sib.swiss/store/fdp/sparql> .

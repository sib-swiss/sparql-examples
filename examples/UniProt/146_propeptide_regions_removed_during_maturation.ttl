@prefix ex: <https://sparql.uniprot.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:146_propeptide_regions_removed_during_maturation a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find propeptide regions of reviewed human proteins that are removed during protein maturation, with their extent"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX up: <http://purl.uniprot.org/core/>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX faldo: <http://biohackathon.org/resource/faldo#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?protein ?description ?begin ?end
WHERE {
  ?protein a up:Protein ;
    up:organism taxon:9606 ;
    up:reviewed true ;
    up:annotation ?annotation .
  ?annotation a up:Propeptide_Annotation ;
    up:range ?range .
  OPTIONAL { ?annotation rdfs:comment ?description }
  ?range faldo:begin/faldo:position ?begin ;
    faldo:end/faldo:position ?end .
}""" ;
    schema:keywords "propeptide" , "molecule processing" ;
    schema:target <https://sparql.uniprot.org/sparql/> .

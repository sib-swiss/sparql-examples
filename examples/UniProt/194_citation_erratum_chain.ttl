@prefix ex: <https://sparql.uniprot.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:194_citation_erratum_chain a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find publications that have a published erratum/correction, linking the original citation to its corrigendum"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX up: <http://purl.uniprot.org/core/>

SELECT
  ?citation
  ?title
  ?erratum
  ?erratumTitle
WHERE {
  ?citation up:erratum ?erratum ;
    up:title ?title .
  ?erratum up:title ?erratumTitle .
}""" ;
    schema:keywords "citation" , "erratum" , "correction" ;
    schema:target <https://sparql.uniprot.org/sparql/> .

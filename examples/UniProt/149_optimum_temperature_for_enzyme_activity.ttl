@prefix ex: <https://sparql.uniprot.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:149_optimum_temperature_for_enzyme_activity a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find the optimum temperature or thermostability reported for the activity of reviewed human enzymes"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX up: <http://purl.uniprot.org/core/>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?protein ?temperatureDependence
WHERE {
  ?protein a up:Protein ;
    up:organism taxon:9606 ;
    up:reviewed true ;
    up:annotation ?annotation .
  ?annotation a up:Temperature_Dependence_Annotation ;
    rdfs:comment ?temperatureDependence .
}""" ;
    schema:keywords "enzyme" , "temperature" , "thermostability" , "biophysicochemical property" ;
    schema:target <https://sparql.uniprot.org/sparql/> .

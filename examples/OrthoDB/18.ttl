@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:18 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find orthologs in three distant species of the diabetes-implicated (according to <a href=\"https://sparql.uniprot.org/sparql\">UniProt SPARQL endpoint</a>) human genes via Vertebrata-level orthology"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT
?human_diabetes_related_gene ?upfullname ?organism ?orthogene ?ortholog_fullname
WHERE {

    SERVICE <https://sparql.uniprot.org/sparql> {

        SELECT
        ?human_diabetes_related_gene ?upfullname
        WHERE {
            ?human_diabetes_related_gene a up:Protein ;
            up:organism taxon:9606 ;
            up:annotation ?annotation ;
            up:recommendedName/up:fullName ?upfullname .
            ?annotation rdfs:comment ?annotation_text .
            ?annotation a up:Disease_Annotation .
            FILTER CONTAINS (?annotation_text, "diabetes")
        }
    } ?gene :xref/:xrefResource ?human_diabetes_related_gene .
    ?human_diabetes_related_gene a :Uniprot .
    ?gene a :Gene ;
    up:organism/:genomeID 'GCF_009914755.1' .
    ?gene :memberOf ?og .
    ?og :ogBuiltAt/up:scientificName "Vertebrata" ;
    :hasMember ?orthogene .
    ?orthogene :description ?ortholog_fullname ;
    up:organism/up:scientificName ?organism .
    FILTER (?organism in ('Danio rerio', 'Anolis carolinensis', 'Gallus gallus') )
}
ORDER BY ?human_diabetes_related_gene ?organism""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


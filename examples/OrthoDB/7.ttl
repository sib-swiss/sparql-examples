@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:7 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find Drosophila melanogaster genes along with some properties by gene symbols starting with \"DEAD\""@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT *
WHERE {
    ?gene a :Gene ;
    up:organism [up:scientificName "Drosophila melanogaster"] .
    ?gene :name ?gene_name ;
    :geneTranslatedLength ?aa_seq_length ;
    :description ?description .
    OPTIONAL {
        ?gene :geneNbExons ?geneNbExons
    } .
    ?gene :aaSequence ?sequence
    FILTER (STRSTARTS (?gene_name, 'DEAD'))
}
ORDER BY ?gene_name""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


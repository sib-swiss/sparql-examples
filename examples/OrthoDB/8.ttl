@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:8 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find in any organsim under Bacillus all genes containing word \"protease\", case-insensitive, anywhere in description"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT
*
WHERE {
    ?tx rdfs:subClassOf+/up:scientificName "Bacillus" .
    ?gene a :Gene ;
    up:organism/a ?tx ;
    :description ?description .
    FILTER (contains (lcase(?description), "protease" ))
}""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


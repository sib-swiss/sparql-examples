@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:14 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find genes along with their properties by their xrefs, e.g. by Uniprot ids <a href=\"https://purl.uniprot.org/uniprot/P12345\" target=\"uniprot\">P12345</a> or <a href=\"https://purl.uniprot.org/uniprot/Q99999\" target=\"uniprot\">Q99999</a>, or by NCBI gene ids  <a href=\"https://www.ncbi.nlm.nih.gov/gene/1\" target=\"entrezgene\">1</a> or <a href=\"https://www.ncbi.nlm.nih.gov/gene/1111\" target=\"entrezgene\">1111</a>"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX entrezgene: <http://www.ncbi.nlm.nih.gov/gene/>
PREFIX uniprot: <http://purl.uniprot.org/uniprot/>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT
*
WHERE {
    ?gene a :Gene .
    ?gene :name ?gene_name ;
    :description ?description ;
    up:organism [up:scientificName ?org_name] .
    ?gene :xref [a :Xref ;
    :xrefResource ?xref]
    FILTER (?xref in ( uniprot:P12345 ,uniprot:Q99999 ,entrezgene:1 ,entrezgene:1111 ))
}""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


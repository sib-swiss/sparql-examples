@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:20 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find single-copy phyletic profile at all levels of orthology for the genes interacting with mouse gene \"Babam2\", as annotated by <a href=\"https://sparql.string-db.org/\">STRING</a> database"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX ip_highest: <http://string-db.org/rdf/interaction/physical-highest-confidence-cutoff>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT
?gene_m ?partner_m ?string_partner_genename ?level ?distance2top ?percent_single_copy
WHERE {
    ?gene_m up:organism / up:scientificName "Mus musculus" ; a :Gene ; :name "Babam2".
    ?gene_m  :xref / :xrefResource ?xref_m .
    ?xref_m a :Entrezgene .
 
    # linking to STRING database by NCBI gene ID
    SERVICE <https://sparql.string-db.org/> {
        ?string_gene_m rdfs:seeAlso ?xref_m ;
        ip_highest: ?partner_m .
        ?partner_m rdfs:label ?string_partner_genename ;
        rdfs:comment ?string_partner_description
    } 

    # linking back to OrthoDB gene by gene name, which is normally unique within same species
    ?gene_m2 a :Gene ;
    up:organism / up:scientificName "Mus musculus" ;
    :name ?string_partner_genename ;
 
    # get orthogroups at all levels with info such as percentage single copy
    :memberOf ?og .
    ?og :ogPercentSingleCopy ?percent_single_copy.
    ?og :ogBuiltAt [ :taxTreeDistance ?distance2top ] .
    ?og :ogBuiltAt [ up:scientificName ?level ] .
    
} order by ?string_partner_genename ?distance2top""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


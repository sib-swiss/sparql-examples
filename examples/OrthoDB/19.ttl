@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:19 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find assortment of reactions catalyzed by the genes in Eukaryota-level orthologous group/s annotated with <a href=\"https://www.ebi.ac.uk/interpro/entry/IPR002328\" target=\"interpro\">IPR002328</a>, alcohol dehydrogenase. Search across species in Acari or Drosophila clades, using cooperation with both <a href=\"https://sparql.uniprot.org/sparql\">Uniprot SPARQL endpoint</a> and <a href=\"https://sparql.rhea-db.org/sparql\">RHEA SPARQL endpoint</a>"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX rh: <http://rdf.rhea-db.org/>
PREFIX interpro: <http://www.ebi.ac.uk/interpro/entry/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT 
?og ?og_name ?equation 
(group_concat (DISTINCT ?clade_name; SEPARATOR="; ") as ?clades) 
(count(DISTINCT ?taxon) as ?cnt_taxons) 
(count(DISTINCT ?gene) as ?cnt_genes) 
(group_concat (DISTINCT ?org_name; SEPARATOR="; ") as ?taxons)
WHERE {
    ?taxon a :Species ;
    up:scientificName ?org_name ;
    rdfs:subClassOf+/up:scientificName ?clade_name .
    ?gene a :Gene ;
    up:organism/a ?taxon .
    ?gene rdfs:seeAlso ?xref .
    ?xref a :Uniprot .
    ?gene :memberOf ?og .
    ?og :xref/:xrefResource interpro:IPR002328 ; :name ?og_name ;
    :ogBuiltAt/up:scientificName "Eukaryota" .

    # restrict taxons to several clades values
    FILTER ( ?clade_name in ( "Acari", "Drosophila" )) 

    # join via uniprot ?xref
    SERVICE <https://sparql.uniprot.org/sparql> {
        ?xref a up:Protein ;
        up:annotation/up:catalyticActivity/up:catalyzedReaction ?rh
    } 
    # join via reaction ?rh
    SERVICE <https://sparql.rhea-db.org/sparql> {
        ?rh rdfs:subClassOf rh:Reaction ;
        rh:equation ?equation .
    }
}
GROUP BY ?equation ?og ?og_name
ORDER BY ?og ?equation""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


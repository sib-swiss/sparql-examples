@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:9 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find human orthologs of mouse genes annotated by Uniprot keywords \"Serine/threonine-protein kinase\" and  \"DNA damage\""@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT
*
WHERE {
    ?og a :OrthoGroup .
    ?og :ogBuiltAt taxon:314146 .
    ?gene_m a :Gene ; up:organism/a taxon:10090 ; :name ?gene_m_name ; :description ?gene_m_description .
    ?gene_h a :Gene ; up:organism/a taxon:9606 ;  :name ?gene_h_name ; :description ?gene_h_description .
    ?gene_m :memberOf ?og .
    ?gene_h :memberOf ?og .
    ?gene_m :geneUpkw "Serine/threonine-protein kinase", "DNA damage".
}""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


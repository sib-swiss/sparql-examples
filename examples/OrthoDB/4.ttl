@prefix ex: <https://sparql.orthodb.org/.well-known/sparql-examples/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:4 a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Find URI and some properties of the orthologous group 22at2759 by its short text label"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """PREFIX : <http://purl.orthodb.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT
*
WHERE {
    ?og a :OrthoGroup ;
    rdfs:label "22at2759" ;
    :name ?description ;
    :ogBuiltAt [up:scientificName ?clade]
}""" ;
    schema:target <https://sparql.orthodb.org/sparql/> .


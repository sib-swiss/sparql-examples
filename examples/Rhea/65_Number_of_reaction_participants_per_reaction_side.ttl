@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://sparql.rhea-db.org/.well-known/sparql-examples/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:65_Number_of_reaction_participants_per_reaction_side a sh:SPARQLExecutable,
    sh:SPARQLSelectExecutable;
  rdfs:comment "Histogram of reaction sides by their number of participants - across all approved Rhea reactions, how many sides have exactly 1, 2, 3... participants (e.g. is a side with 11 distinct participants an outlier)"@en ;
  sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rh:<http://rdf.rhea-db.org/>

SELECT
  ?participantCount
  (COUNT(*) AS ?sideCount)
WHERE {
  {
    SELECT ?side (COUNT(DISTINCT ?participant) AS ?participantCount)
    WHERE {
      ?reaction rdfs:subClassOf rh:Reaction ;
        rh:status rh:Approved ;
        rh:side ?side .
      ?side rh:contains ?participant .
    }
    GROUP BY ?side
  }
}
GROUP BY ?participantCount
ORDER BY ?participantCount
""";
  schema:target <https://sparql.rhea-db.org/sparql> .
